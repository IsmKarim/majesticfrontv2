# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development; set these in your host's dashboard for
# deployed environments. Everything prefixed NEXT_PUBLIC_ is inlined into the
# browser bundle at BUILD time — never put a secret behind that prefix, and
# remember a value change requires a rebuild, not just a restart.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Canonical origin of this deployment, no trailing slash.
# Drives canonicals, hreflang alternates, sitemap.xml and JSON-LD.
# Preview/staging MUST override this or they will advertise production URLs.
NEXT_PUBLIC_SITE_URL=https://majestickeys.ma

# REQUIRED once the property API exists. Absolute base URL of the backend.
# Falls back to the relative "/api", which only resolves for same-origin routes.
NEXT_PUBLIC_API_URL=https://api.majestickeys.com/v1

# ── Optional analytics / tracking ────────────────────────────────────────────
# Read by src/config/site.ts but NOT yet rendered by any component — setting
# these alone does nothing until the scripts are wired into the layout.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_HOTJAR_ID=

# ── Optional maps ────────────────────────────────────────────────────────────
# Public, domain-restrict them in the provider console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
